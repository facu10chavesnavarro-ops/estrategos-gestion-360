# =============================================================================
#  Plantilla de variables de entorno de PRODUCCIÓN — Estrategos Gestión 360
# =============================================================================
#
#  Uso:
#    - docker-compose local: copiar a `.env` y completar los <placeholders>.
#        cp .env.production.example .env
#    - Vercel / Render / Fly: cargar estas claves en el panel del proveedor
#      (o vía `render.yaml` / `fly secrets set`).
#
#  REGLAS
#    * NUNCA commitear el `.env` real. `.gitignore` ya ignora `.env` y `.env.*`
#      excepto los `*.example`.
#    * Todo lo que diga <...> es un placeholder: hay que reemplazarlo.
#    * Generar secretos aleatorios con:   openssl rand -base64 48
#
#  Este archivo es SÓLO para producción. El `apps/*/.env.example` sigue siendo
#  la plantilla de desarrollo local (valores por defecto, sin secretos reales).
# -----------------------------------------------------------------------------


# ─────────────────────────────────────────────────────────────────────────────
#  BACKEND  ·  @estrategos/api  (NestJS)
# ─────────────────────────────────────────────────────────────────────────────

# --- Base de datos ---------------------------------------------------------
# String de conexión a Postgres. En un proveedor gestionado (Render, Neon,
# Fly Postgres, Supabase) usar la que te dan; casi siempre requiere SSL:
#   postgresql://USER:PASSWORD@HOST:5432/DB?schema=public&sslmode=require
# En docker-compose NO hace falta setearla: se arma sola desde POSTGRES_* y
# apunta al servicio "db".
DATABASE_URL="postgresql://<user>:<password>@<host>:5432/<database>?schema=public&sslmode=require"

# --- Autenticación / JWT  · SECRETOS OBLIGATORIOS -------------------------
# Dos secretos DISTINTOS entre sí, largos y aleatorios (>= 32 bytes).
# El arranque de la API falla si faltan.
JWT_SECRET="<openssl rand -base64 48>"
JWT_REFRESH_SECRET="<openssl rand -base64 48 — distinto del anterior>"

# --- HTTP / CORS ---------------------------------------------------------
# Puerto en el que escucha la API. Render/Fly inyectan PORT solos; respetarlo.
PORT="3001"
# Origen(es) del frontend con permiso de CORS, separados por coma, SIN barra
# final. En prod apuntar al dominio real del front (no localhost).
CORS_ORIGIN="https://<tu-frontend>.vercel.app"


# ─────────────────────────────────────────────────────────────────────────────
#  FRONTEND  ·  @estrategos/web  (Next.js)
# ─────────────────────────────────────────────────────────────────────────────

# URL pública de la API. Prefijo NEXT_PUBLIC_ => queda HORNEADA en el bundle
# del cliente en build-time: si cambia, hay que reconstruir el frontend.
NEXT_PUBLIC_API_URL="https://<tu-api>.onrender.com"


# ─────────────────────────────────────────────────────────────────────────────
#  SÓLO docker-compose  ·  Postgres local que simula producción
# ─────────────────────────────────────────────────────────────────────────────
# Un proveedor gestionado ignora estas: allá sólo importa DATABASE_URL.
POSTGRES_USER="estrategos"
POSTGRES_PASSWORD="<password-fuerte-para-postgres-local>"
POSTGRES_DB="estrategos"
POSTGRES_PORT="5432"


# ─────────────────────────────────────────────────────────────────────────────
#  CHECKLIST DE SECRETOS QUE HAY QUE PROVISIONAR EN EL PROVEEDOR
# ─────────────────────────────────────────────────────────────────────────────
#   [ ] DATABASE_URL          conexión Postgres (con SSL en gestionado)
#   [ ] JWT_SECRET            aleatorio, único                  (backend)
#   [ ] JWT_REFRESH_SECRET    aleatorio, único, != JWT_SECRET   (backend)
#   [ ] CORS_ORIGIN           dominio real del frontend         (backend)
#   [ ] NEXT_PUBLIC_API_URL   dominio real de la API            (frontend, build-time)
#
#   No secreto pero requerido: PORT (lo inyecta el proveedor), NODE_ENV=production.
