// Sprint 0 — solo el modelo core (tenant, empresa, usuario, roles, auth).
// Las entidades transaccionales (ventas, compras, caja, etc.) se agregan
// en Sprint 2+ una vez que Sprint 0/1 estén cerrados.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Consultora que administra una o más empresas (RN de la sección 7 del doc fuente).
model Tenant {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  companies Company[]

  @@map("tenants")
}

/// Empresa (unidad legal/operativa cuyos datos deben aislarse — RN-001, RN-002).
model Company {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  legalName          String   @map("legal_name")
  taxId              String?  @map("tax_id") // CUIT
  taxCondition       String?  @map("tax_condition")
  activity           String?
  address            String?
  contactName        String?  @map("contact_name")
  contactEmail       String?  @map("contact_email")
  contactPhone       String?  @map("contact_phone")
  logoUrl            String?  @map("logo_url")
  currency           String   @default("ARS")
  timezone           String   @default("America/Argentina/Jujuy")
  allowNegativeStock Boolean  @default(false) @map("allow_negative_stock")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  companyUsers     CompanyUser[]
  auditLogs        AuditLog[]
  branches         Branch[]
  invitations      Invitation[]
  parties          Party[]
  customers        Customer[]
  suppliers        Supplier[]
  categories       Category[]
  items            Item[]
  taxes            Tax[]
  priceLists       PriceList[]
  warehouses       Warehouse[]
  stockMovements   StockMovement[]
  pointsOfSale     PointOfSale[]
  vouchers         Voucher[]
  customerAccounts CustomerAccount[]
  supplierAccounts SupplierAccount[]
  payments         Payment[]
  bankAccounts     BankAccount[]
  cashRegisters    CashRegister[]

  @@index([tenantId])
  @@map("companies")
}

/// Sucursal o punto operativo de una empresa (M02, RN-EMP-01/09).
model Branch {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  name      String
  address   String?
  phone     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company       Company        @relation(fields: [companyId], references: [id])
  warehouses    Warehouse[]
  pointsOfSale  PointOfSale[]
  cashRegisters CashRegister[]

  @@index([companyId])
  @@index([companyId, isActive])
  @@map("branches")
}

/// Persona con credenciales de acceso (no lleva rol propio: el rol es por empresa).
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  companyUsers       CompanyUser[]
  refreshTokens      RefreshToken[]
  auditLogs          AuditLog[]
  invitationsSent    Invitation[]    @relation("InvitationsSent")
  invitationsRevoked Invitation[]    @relation("InvitationsRevoked")
  stockMovements     StockMovement[]

  @@map("users")
}

/// Rol asignable por empresa (Superadministrador, Administrador Estrategos,
/// Consultor, Propietario, Administrador de empresa, Contador externo,
/// Empleado, Auditor — sección 6.3 del documento fuente).
model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  companyUsers CompanyUser[]
  invitations  Invitation[]

  @@map("roles")
}

/// Tabla puente: un usuario tiene un rol DISTINTO por cada empresa a la que accede.
model CompanyUser {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  companyId String   @map("company_id")
  roleId    String   @map("role_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])
  role    Role    @relation(fields: [roleId], references: [id])

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([companyId, isActive])
  @@map("company_users")
}

/// Invitación de un usuario a una empresa con un rol (M01, RN-USR-*).
/// El token en sí nunca se persiste, solo su hash (tokenHash).
/// El estado (pendiente/aceptada/revocada/expirada) se calcula a partir de
/// acceptedAt/revokedAt/expiresAt — no hay columna de estado redundante.
model Invitation {
  id              String    @id @default(uuid())
  companyId       String    @map("company_id")
  email           String
  roleId          String    @map("role_id")
  tokenHash       String    @map("token_hash")
  invitedByUserId String    @map("invited_by_user_id")
  revokedByUserId String?   @map("revoked_by_user_id")
  expiresAt       DateTime  @map("expires_at")
  acceptedAt      DateTime? @map("accepted_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  company   Company @relation(fields: [companyId], references: [id])
  role      Role    @relation(fields: [roleId], references: [id])
  invitedBy User    @relation("InvitationsSent", fields: [invitedByUserId], references: [id])
  revokedBy User?   @relation("InvitationsRevoked", fields: [revokedByUserId], references: [id])

  @@index([companyId])
  @@index([email])
  @@map("invitations")
}

/// Refresh tokens rotables y revocables (nunca se guarda el token en texto plano).
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

/// Registro inmutable de acciones sensibles (RN-009). No editable por diseño:
/// no se expone ningún endpoint PATCH/DELETE para este modelo.
model AuditLog {
  id         String   @id @default(uuid())
  companyId  String?  @map("company_id")
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  company Company? @relation(fields: [companyId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([entityType, entityId])
  // Soporta reportes de auditoría filtrados por empresa y período (R09) sin
  // table scan a medida que la tabla crece sin límite (ver decisión en
  // docs/ARQUITECTURA.md sección 8).
  @@index([companyId, createdAt])
  @@map("audit_logs")
}

/// Tercero: persona física o jurídica con la que la empresa opera (M03/M04).
/// Datos fiscales/legales/de contacto compartidos entre Cliente y Proveedor
/// para que la misma persona pueda ser ambos sin duplicar información
/// (decisión de Sprint 2, ver docs/sprint-2/01-clientes-proveedores.md §0.4).
model Party {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  legalName    String   @map("legal_name")
  taxId        String?  @map("tax_id")
  taxCondition String?  @map("tax_condition")
  email        String?
  phone        String?
  address      String?
  contactName  String?  @map("contact_name")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company  Company   @relation(fields: [companyId], references: [id])
  customer Customer?
  supplier Supplier?
  vouchers Voucher[]
  payments Payment[]

  @@unique([companyId, taxId])
  @@index([companyId])
  @@map("parties")
}

/// Rol de Cliente de un Party (M03). `companyId` duplicado deliberadamente
/// respecto de Party.companyId — ver decisión de escalabilidad en
/// docs/sprint-2/01-clientes-proveedores.md §0.5: nunca se edita
/// independientemente, mantiene el patrón de columna directa de todo el
/// sistema y deja el terreno listo para Row Level Security.
model Customer {
  id                   String   @id @default(uuid())
  partyId              String   @unique @map("party_id")
  companyId            String   @map("company_id")
  paymentTermDays      Int?     @map("payment_term_days")
  creditLimit          Decimal? @map("credit_limit") @db.Decimal(14, 2)
  preferredPriceListId String?  @map("preferred_price_list_id")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  party              Party            @relation(fields: [partyId], references: [id])
  company            Company          @relation(fields: [companyId], references: [id])
  preferredPriceList PriceList?       @relation(fields: [preferredPriceListId], references: [id])
  account            CustomerAccount?

  @@index([companyId])
  @@index([companyId, isActive])
  @@map("customers")
}

/// Rol de Proveedor de un Party (M04). Mismas notas que Customer sobre
/// companyId duplicado. paymentTermDays tiene significado inverso al de
/// Customer (condición de compra, no de venta) — por eso no se comparte
/// aunque el tipo sea igual.
model Supplier {
  id                String   @id @default(uuid())
  partyId           String   @unique @map("party_id")
  companyId         String   @map("company_id")
  paymentTermDays   Int?     @map("payment_term_days")
  bankName          String?  @map("bank_name")
  bankAccountHolder String?  @map("bank_account_holder")
  bankCbu           String?  @map("bank_cbu")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  party   Party            @relation(fields: [partyId], references: [id])
  company Company          @relation(fields: [companyId], references: [id])
  account SupplierAccount?

  @@index([companyId])
  @@index([companyId, isActive])
  @@map("suppliers")
}

/// Categoría jerárquica de Ítems (Sprint 3, docs/sprint-3/01-catalogo-maestro.md).
/// Lista de adyacencia (parentId autoreferenciado), profundidad ilimitada.
model Category {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  parentId  String?  @map("parent_id")
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company  Company    @relation(fields: [companyId], references: [id])
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  items    Item[]

  @@index([companyId])
  @@index([companyId, parentId])
  @@map("categories")
}

enum ItemType {
  PRODUCT
  SERVICE
}

/// Producto o Servicio unificado (RN-CAT-06/07/08). tracksStock/minimumStock
/// solo tienen sentido si type = PRODUCT.
model Item {
  id            String   @id @default(uuid())
  companyId     String   @map("company_id")
  type          ItemType
  sku           String
  name          String
  description   String?
  categoryId    String?  @map("category_id")
  unitOfMeasure String   @map("unit_of_measure")
  tracksStock   Boolean  @default(false) @map("tracks_stock")
  minimumStock  Decimal? @map("minimum_stock") @db.Decimal(14, 2)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  company        Company         @relation(fields: [companyId], references: [id])
  category       Category?       @relation(fields: [categoryId], references: [id])
  itemTaxes      ItemTax[]
  priceListItems PriceListItem[]
  stocks         Stock[]
  stockMovements StockMovement[]
  voucherLines   VoucherLine[]

  @@unique([companyId, sku])
  @@index([companyId])
  @@index([companyId, isActive])
  @@index([companyId, type])
  @@map("items")
}

enum TaxType {
  VAT
  PERCEPTION
  WITHHOLDING
}

/// Catálogo flexible de impuestos con vigencia (RN-CAT-09/10). La tasa nunca
/// se edita retroactivamente: "cambiar" una tasa es cerrar este Tax
/// (validTo) y crear uno nuevo — preserva la integridad de comprobantes
/// históricos que en Sprint 3.3 copiarán (snapshot) la tasa vigente.
model Tax {
  id        String    @id @default(uuid())
  companyId String    @map("company_id")
  name      String
  type      TaxType
  rate      Decimal   @db.Decimal(6, 4)
  validFrom DateTime  @map("valid_from")
  validTo   DateTime? @map("valid_to")
  createdAt DateTime  @default(now()) @map("created_at")

  company          Company          @relation(fields: [companyId], references: [id])
  itemTaxes        ItemTax[]
  voucherLineTaxes VoucherLineTax[]

  @@index([companyId])
  @@map("taxes")
}

/// Qué impuestos aplican a qué Ítem (RN-CAT-11: un Item puede tener más de
/// uno simultáneamente, ej. IVA + Percepción IIBB).
model ItemTax {
  itemId String @map("item_id")
  taxId  String @map("tax_id")

  item Item @relation(fields: [itemId], references: [id])
  tax  Tax  @relation(fields: [taxId], references: [id])

  @@id([itemId, taxId])
  @@map("item_taxes")
}

/// Lista de precios (neto, sin impuestos — ver §5.2 del documento de
/// arquitectura). RN-CAT-13: a lo sumo una activa por empresa con
/// isDefault = true.
model PriceList {
  id        String    @id @default(uuid())
  companyId String    @map("company_id")
  name      String
  currency  String
  isDefault Boolean   @default(false) @map("is_default")
  validFrom DateTime  @default(now()) @map("valid_from")
  validTo   DateTime? @map("valid_to")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  company              Company         @relation(fields: [companyId], references: [id])
  items                PriceListItem[]
  preferredByCustomers Customer[]

  @@index([companyId])
  @@index([companyId, isActive])
  @@map("price_lists")
}

/// Precio de un Ítem en una Lista de precios. A diferencia del resto del
/// módulo, admite baja física (RN-CAT-04): no es un registro financiero, el
/// precio históricamente facturado queda protegido aparte, como snapshot en
/// la línea del comprobante (Sprint 3.3).
model PriceListItem {
  priceListId String   @map("price_list_id")
  itemId      String   @map("item_id")
  price       Decimal  @db.Decimal(14, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  priceList PriceList @relation(fields: [priceListId], references: [id])
  item      Item      @relation(fields: [itemId], references: [id])

  @@id([priceListId, itemId])
  @@map("price_list_items")
}

/// Depósito de un Ítem dentro de una Sucursal (Sprint 3.2,
/// docs/sprint-3/02-depositos-y-stock.md). companyId duplicado respecto de
/// branch.companyId, mismo criterio que Customer/Supplier/Party.
model Warehouse {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  branchId  String   @map("branch_id")
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company       Company         @relation(fields: [companyId], references: [id])
  branch        Branch          @relation(fields: [branchId], references: [id])
  stocks        Stock[]
  StockMovement StockMovement[]

  @@unique([branchId, name])
  @@index([companyId])
  @@map("warehouses")
}

/// Cantidad y costo promedio ponderado (RN-STK-05) de un Ítem en un
/// Depósito. Nunca se escribe directamente (RN-STK-04) — solo cambia como
/// efecto de un StockMovement, en la misma transacción que lo crea.
model Stock {
  companyId   String   @map("company_id")
  itemId      String   @map("item_id")
  warehouseId String   @map("warehouse_id")
  quantity    Decimal  @default(0) @db.Decimal(14, 3)
  averageCost Decimal  @default(0) @map("average_cost") @db.Decimal(14, 4)
  updatedAt   DateTime @updatedAt @map("updated_at")

  item      Item      @relation(fields: [itemId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@id([itemId, warehouseId])
  @@index([companyId])
  @@map("stock")
}

enum StockMovementType {
  PURCHASE_IN
  SALE_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
  RETURN_IN
  RETURN_OUT
}

/// Ledger inmutable (append-only, igual que AuditLog) de cada entrada o
/// salida de stock. `id` sin @default: se genera con uuidv7() en la capa de
/// infraestructura (ver docs/sprint-3/02-depositos-y-stock.md §0.3) — tabla
/// de alto volumen (Decisión 1.1 del documento de arquitectura).
model StockMovement {
  id              String            @id
  companyId       String            @map("company_id")
  itemId          String            @map("item_id")
  warehouseId     String            @map("warehouse_id")
  type            StockMovementType
  quantity        Decimal           @db.Decimal(14, 3)
  unitCost        Decimal           @map("unit_cost") @db.Decimal(14, 4)
  reason          String?
  transferGroupId String?           @map("transfer_group_id")
  /// Presente cuando el movimiento se originó en un Comprobante confirmado
  /// (Sprint 3.3); ausente en un ajuste/transferencia manual.
  voucherId       String?           @map("voucher_id")
  userId          String            @map("user_id")
  createdAt       DateTime          @default(now()) @map("created_at")

  company   Company   @relation(fields: [companyId], references: [id])
  item      Item      @relation(fields: [itemId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  voucher   Voucher?  @relation(fields: [voucherId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@index([companyId, createdAt])
  @@index([itemId, warehouseId])
  @@index([transferGroupId])
  @@index([voucherId])
  @@map("stock_movements")
}

/// Punto de venta AFIP (Sprint 3.3, docs/sprint-3/03-comprobantes.md).
model PointOfSale {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  branchId  String   @map("branch_id")
  code      String
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company         Company          @relation(fields: [companyId], references: [id])
  branch          Branch           @relation(fields: [branchId], references: [id])
  vouchers        Voucher[]
  voucherCounters VoucherCounter[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("points_of_sale")
}

enum VoucherFlow {
  SALE
  PURCHASE
}

enum StockEffect {
  IN
  OUT
  NONE
}

enum CurrentAccountEffect {
  DEBIT
  CREDIT
  NONE
}

/// Catálogo global de plataforma (como Role) — no pertenece a ninguna
/// empresa. Sprint 3.3 solo sembró FA_A/B/C, NC_A/B/C y FC — ver
/// docs/sprint-3/03-comprobantes.md §0.1 para el resto (Recibo, Remito,
/// Nota de Débito, Orden de Compra, Presupuesto), diferido.
model VoucherType {
  id                     String               @id @default(uuid())
  code                   String               @unique
  name                   String
  flow                   VoucherFlow
  affectsStock           StockEffect          @map("affects_stock")
  affectsCurrentAccount  CurrentAccountEffect @map("affects_current_account")
  requiresCae            Boolean              @map("requires_cae")
  isCreditNote           Boolean              @default(false) @map("is_credit_note")
  relatedVoucherRequired Boolean              @default(false) @map("related_voucher_required")
  isActive               Boolean              @default(true) @map("is_active")

  vouchers Voucher[]

  @@map("voucher_types")
}

/// Contador de numeración fiscal (RN-VOU-02) — incrementado atómicamente
/// vía INSERT ... ON CONFLICT DO UPDATE ... RETURNING dentro de la misma
/// transacción que crea el Voucher.
model VoucherCounter {
  companyId     String @map("company_id")
  pointOfSaleId String @map("point_of_sale_id")
  voucherTypeId String @map("voucher_type_id")
  lastNumber    Int    @default(0) @map("last_number")

  pointOfSale PointOfSale @relation(fields: [pointOfSaleId], references: [id])

  @@id([companyId, pointOfSaleId, voucherTypeId])
  @@map("voucher_counters")
}

/// Comprobante (Factura/Nota de Crédito, Venta o Compra — RN-VOU-01 a 12).
/// `id` sin @default: uuidv7(), tabla de alto volumen. Inmutable una vez
/// creado (RN-VOU-03): no hay UpdateVoucherUseCase ni anulación directa.
model Voucher {
  id                String    @id
  companyId         String    @map("company_id")
  branchId          String    @map("branch_id")
  pointOfSaleId     String    @map("point_of_sale_id")
  voucherTypeId     String    @map("voucher_type_id")
  number            Int
  partyId           String    @map("party_id")
  warehouseId       String?   @map("warehouse_id")
  issueDate         DateTime  @map("issue_date")
  currency          String
  exchangeRate      Decimal   @default(1) @map("exchange_rate") @db.Decimal(10, 4)
  relatedVoucherId  String?   @map("related_voucher_id")
  subtotal          Decimal   @db.Decimal(14, 2)
  taxTotal          Decimal   @map("tax_total") @db.Decimal(14, 2)
  total             Decimal   @db.Decimal(14, 2)
  cae               String?
  caeExpirationDate DateTime? @map("cae_expiration_date")
  createdByUserId   String    @map("created_by_user_id")
  createdAt         DateTime  @default(now()) @map("created_at")

  company                  Company                   @relation(fields: [companyId], references: [id])
  pointOfSale              PointOfSale               @relation(fields: [pointOfSaleId], references: [id])
  voucherType              VoucherType               @relation(fields: [voucherTypeId], references: [id])
  party                    Party                     @relation(fields: [partyId], references: [id])
  relatedVoucher           Voucher?                  @relation("VoucherRelation", fields: [relatedVoucherId], references: [id])
  relatedByNotes           Voucher[]                 @relation("VoucherRelation")
  lines                    VoucherLine[]
  stockMovements           StockMovement[]
  paymentAllocations       PaymentAllocation[]
  customerAccountMovements CustomerAccountMovement[]
  supplierAccountMovements SupplierAccountMovement[]

  @@unique([companyId, pointOfSaleId, voucherTypeId, number])
  @@index([companyId, createdAt])
  @@index([partyId])
  @@map("vouchers")
}

/// Línea de comprobante — snapshot de precio (RN-VOU-05), nunca referencia
/// viva. `id` sin @default: uuidv7(), tabla de altísimo volumen.
model VoucherLine {
  id                 String  @id
  voucherId          String  @map("voucher_id")
  lineNumber         Int     @map("line_number")
  itemId             String? @map("item_id")
  description        String
  quantity           Decimal @db.Decimal(14, 3)
  unitPrice          Decimal @map("unit_price") @db.Decimal(14, 4)
  discountPercentage Decimal @default(0) @map("discount_percentage") @db.Decimal(5, 2)
  subtotal           Decimal @db.Decimal(14, 2)

  voucher Voucher          @relation(fields: [voucherId], references: [id])
  item    Item?            @relation(fields: [itemId], references: [id])
  taxes   VoucherLineTax[]

  @@unique([voucherId, lineNumber])
  @@map("voucher_lines")
}

/// Snapshot de impuesto aplicado a una línea (RN-VOU-05) — tasa y monto
/// congelados al momento de confirmar, nunca recalculados después.
model VoucherLineTax {
  voucherLineId String  @map("voucher_line_id")
  taxId         String  @map("tax_id")
  rate          Decimal @db.Decimal(6, 4)
  amount        Decimal @db.Decimal(14, 2)

  voucherLine VoucherLine @relation(fields: [voucherLineId], references: [id])
  tax         Tax         @relation(fields: [taxId], references: [id])

  @@id([voucherLineId, taxId])
  @@map("voucher_line_taxes")
}

/// Catálogo global de plataforma (como VoucherType/Role) — Sprint 3.4,
/// docs/sprint-3/04-tesoreria.md §0.5. requiresCashMovement/
/// requiresBankMovement no tienen lector todavía (Sprint 3.5).
model PaymentMethod {
  id                   String  @id @default(uuid())
  code                 String  @unique
  name                 String
  requiresCheckDetail  Boolean @default(false) @map("requires_check_detail")
  requiresCardDetail   Boolean @default(false) @map("requires_card_detail")
  requiresCashMovement Boolean @default(false) @map("requires_cash_movement")
  requiresBankMovement Boolean @default(false) @map("requires_bank_movement")
  isActive             Boolean @default(true) @map("is_active")

  methodDetails PaymentMethodDetail[]

  @@map("payment_methods")
}

enum CheckStatus {
  EN_CARTERA
  DEPOSITADO
  RECHAZADO
  COBRADO
}

/// Sin lógica de transición de estado en este sub-sprint (§0.2 de
/// docs/sprint-3/04-tesoreria.md) — status queda en EN_CARTERA al crear.
model CheckDetail {
  id        String      @id @default(uuid())
  number    String
  bankName  String      @map("bank_name")
  dueDate   DateTime    @map("due_date")
  status    CheckStatus @default(EN_CARTERA)
  createdAt DateTime    @default(now()) @map("created_at")

  methodDetail PaymentMethodDetail?

  @@map("check_details")
}

/// Deliberadamente mínimo, sin ciclo de vida propio (§0.6).
model CardDetail {
  id                String   @id @default(uuid())
  authorizationCode String?  @map("authorization_code")
  batchNumber       String?  @map("batch_number")
  settlementEntity  String?  @map("settlement_entity")
  createdAt         DateTime @default(now()) @map("created_at")

  methodDetail PaymentMethodDetail?

  @@map("card_details")
}

enum PaymentDirection {
  COLLECTION
  PAYMENT
}

/// Cobro/pago (RN-PAY-01 a 09). `id` sin @default: uuidv7(), tabla de
/// alto volumen. Inmutable una vez creado (RN-PAY-06).
model Payment {
  id              String           @id
  companyId       String           @map("company_id")
  partyId         String           @map("party_id")
  direction       PaymentDirection
  date            DateTime
  currency        String
  exchangeRate    Decimal          @default(1) @map("exchange_rate") @db.Decimal(10, 4)
  totalAmount     Decimal          @map("total_amount") @db.Decimal(14, 2)
  createdByUserId String           @map("created_by_user_id")
  createdAt       DateTime         @default(now()) @map("created_at")

  company       Company               @relation(fields: [companyId], references: [id])
  party         Party                 @relation(fields: [partyId], references: [id])
  allocations   PaymentAllocation[]
  methodDetails PaymentMethodDetail[]
  cashMovements CashMovement[]
  bankMovements BankMovement[]

  @@index([companyId, createdAt])
  @@index([partyId])
  @@map("payments")
}

/// Imputación de un Payment a un Voucher (RN-PAY-03/04/05) — permite
/// pagos parciales y pagos que cubren varios comprobantes.
model PaymentAllocation {
  id            String  @id
  paymentId     String  @map("payment_id")
  voucherId     String  @map("voucher_id")
  amountApplied Decimal @map("amount_applied") @db.Decimal(14, 2)

  payment Payment @relation(fields: [paymentId], references: [id])
  voucher Voucher @relation(fields: [voucherId], references: [id])

  @@index([paymentId])
  @@index([voucherId])
  @@map("payment_allocations")
}

/// Reparto de un Payment entre varios medios (RN-PAY-02/07).
model PaymentMethodDetail {
  id              String  @id
  paymentId       String  @map("payment_id")
  paymentMethodId String  @map("payment_method_id")
  amount          Decimal @db.Decimal(14, 2)
  reference       String?
  checkDetailId   String? @unique @map("check_detail_id")
  cardDetailId    String? @unique @map("card_detail_id")

  payment       Payment       @relation(fields: [paymentId], references: [id])
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  checkDetail   CheckDetail?  @relation(fields: [checkDetailId], references: [id])
  cardDetail    CardDetail?   @relation(fields: [cardDetailId], references: [id])

  @@index([paymentId])
  @@map("payment_method_details")
}

enum CurrentAccountMovementType {
  DEBIT
  CREDIT
}

/// RN-CTA-01: se crea implícitamente (upsert) en el primer movimiento,
/// sin alta manual — mismo patrón que Stock (Sprint 3.2).
model CustomerAccount {
  id             String  @id @default(uuid())
  companyId      String  @map("company_id")
  customerId     String  @unique @map("customer_id")
  currentBalance Decimal @default(0) @map("current_balance") @db.Decimal(14, 2)

  company   Company                   @relation(fields: [companyId], references: [id])
  customer  Customer                  @relation(fields: [customerId], references: [id])
  movements CustomerAccountMovement[]

  @@map("customer_accounts")
}

/// RN-CTA-02/03: inmutable, balanceAfter es snapshot. DEBIT aumenta el
/// saldo, CREDIT lo disminuye (convención unificada, §0.3).
model CustomerAccountMovement {
  id                String                     @id
  customerAccountId String                     @map("customer_account_id")
  type              CurrentAccountMovementType
  amount            Decimal                    @db.Decimal(14, 2)
  balanceAfter      Decimal                    @map("balance_after") @db.Decimal(14, 2)
  voucherId         String?                    @map("voucher_id")
  paymentId         String?                    @map("payment_id")
  createdAt         DateTime                   @default(now()) @map("created_at")

  customerAccount CustomerAccount @relation(fields: [customerAccountId], references: [id])
  voucher         Voucher?        @relation(fields: [voucherId], references: [id])

  @@index([customerAccountId, createdAt])
  @@map("customer_account_movements")
}

/// RN-CTA-01: análogo a CustomerAccount.
model SupplierAccount {
  id             String  @id @default(uuid())
  companyId      String  @map("company_id")
  supplierId     String  @unique @map("supplier_id")
  currentBalance Decimal @default(0) @map("current_balance") @db.Decimal(14, 2)

  company   Company                   @relation(fields: [companyId], references: [id])
  supplier  Supplier                  @relation(fields: [supplierId], references: [id])
  movements SupplierAccountMovement[]

  @@map("supplier_accounts")
}

/// RN-CTA-02/03: análogo a CustomerAccountMovement.
model SupplierAccountMovement {
  id                String                     @id
  supplierAccountId String                     @map("supplier_account_id")
  type              CurrentAccountMovementType
  amount            Decimal                    @db.Decimal(14, 2)
  balanceAfter      Decimal                    @map("balance_after") @db.Decimal(14, 2)
  voucherId         String?                    @map("voucher_id")
  paymentId         String?                    @map("payment_id")
  createdAt         DateTime                   @default(now()) @map("created_at")

  supplierAccount SupplierAccount @relation(fields: [supplierAccountId], references: [id])
  voucher         Voucher?        @relation(fields: [voucherId], references: [id])

  @@index([supplierAccountId, createdAt])
  @@map("supplier_account_movements")
}

model CashRegister {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  branchId  String   @map("branch_id")
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company  Company       @relation(fields: [companyId], references: [id])
  branch   Branch        @relation(fields: [branchId], references: [id])
  sessions CashSession[]

  @@index([companyId])
  @@map("cash_registers")
}

/// RN-CASH-02: un CashRegister solo puede tener una sesión abierta
/// (closedAt = NULL) a la vez — verificado con una consulta antes de
/// abrir, no con un constraint de DB (mismo criterio aplicativo ya usado
/// en otras unicidades de este núcleo).
model CashSession {
  id              String    @id @default(uuid())
  cashRegisterId  String    @map("cash_register_id")
  openedByUserId  String    @map("opened_by_user_id")
  openingBalance  Decimal   @map("opening_balance") @db.Decimal(14, 2)
  openedAt        DateTime  @default(now()) @map("opened_at")
  closedByUserId  String?   @map("closed_by_user_id")
  closingBalance  Decimal?  @map("closing_balance") @db.Decimal(14, 2)
  expectedBalance Decimal?  @map("expected_balance") @db.Decimal(14, 2)
  difference      Decimal?  @db.Decimal(14, 2)
  closedAt        DateTime? @map("closed_at")

  cashRegister CashRegister   @relation(fields: [cashRegisterId], references: [id])
  movements    CashMovement[]

  @@index([cashRegisterId])
  @@map("cash_sessions")
}

enum CashMovementType {
  IN
  OUT
}

/// `id` sin @default: uuidv7(), tabla de alto volumen. RN-CASH-05:
/// `reason` obligatorio si `paymentId` es NULL (movimiento manual).
model CashMovement {
  id            String           @id
  cashSessionId String           @map("cash_session_id")
  type          CashMovementType
  amount        Decimal          @db.Decimal(14, 2)
  paymentId     String?          @map("payment_id")
  reason        String?
  createdAt     DateTime         @default(now()) @map("created_at")

  cashSession CashSession @relation(fields: [cashSessionId], references: [id])
  payment     Payment?    @relation(fields: [paymentId], references: [id])

  @@index([cashSessionId, createdAt])
  @@map("cash_movements")
}

enum BankAccountType {
  CHECKING
  SAVINGS
}

model BankAccount {
  id            String          @id @default(uuid())
  companyId     String          @map("company_id")
  bankName      String          @map("bank_name")
  accountType   BankAccountType @map("account_type")
  accountNumber String?         @map("account_number")
  cbu           String?
  alias         String?
  currency      String
  isActive      Boolean         @default(true) @map("is_active")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  company   Company        @relation(fields: [companyId], references: [id])
  movements BankMovement[]

  @@index([companyId])
  @@map("bank_accounts")
}

enum BankMovementType {
  DEPOSIT
  WITHDRAWAL
}

/// `id` sin @default: uuidv7(), tabla de alto volumen. `isReconciled`
/// queda siempre false en este sub-sprint (§0.2) — sin lógica de
/// conciliación bancaria. RN-BANK-03: `description` obligatorio si
/// `paymentId` es NULL.
model BankMovement {
  id            String           @id
  bankAccountId String           @map("bank_account_id")
  type          BankMovementType
  amount        Decimal          @db.Decimal(14, 2)
  paymentId     String?          @map("payment_id")
  description   String?
  date          DateTime
  isReconciled  Boolean          @default(false) @map("is_reconciled")
  reconciledAt  DateTime?        @map("reconciled_at")
  createdAt     DateTime         @default(now()) @map("created_at")

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id])
  payment     Payment?    @relation(fields: [paymentId], references: [id])

  @@index([bankAccountId, date])
  @@map("bank_movements")
}
