// Sprint 0 — solo el modelo core (tenant, empresa, usuario, roles, auth).
// Las entidades transaccionales (ventas, compras, caja, etc.) se agregan
// en Sprint 2+ una vez que Sprint 0/1 estén cerrados.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Consultora que administra una o más empresas (RN de la sección 7 del doc fuente).
model Tenant {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  companies Company[]

  @@map("tenants")
}

/// Empresa (unidad legal/operativa cuyos datos deben aislarse — RN-001, RN-002).
model Company {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  legalName    String   @map("legal_name")
  taxId        String?  @map("tax_id") // CUIT
  taxCondition String?  @map("tax_condition")
  activity     String?
  address      String?
  contactName  String?  @map("contact_name")
  contactEmail String?  @map("contact_email")
  contactPhone String?  @map("contact_phone")
  logoUrl      String?  @map("logo_url")
  currency     String   @default("ARS")
  timezone     String   @default("America/Argentina/Jujuy")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  companyUsers CompanyUser[]
  auditLogs    AuditLog[]
  branches     Branch[]
  invitations  Invitation[]
  parties      Party[]
  customers    Customer[]
  suppliers    Supplier[]
  categories   Category[]
  items        Item[]
  taxes        Tax[]
  priceLists   PriceList[]

  @@index([tenantId])
  @@map("companies")
}

/// Sucursal o punto operativo de una empresa (M02, RN-EMP-01/09).
model Branch {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  name      String
  address   String?
  phone     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([companyId, isActive])
  @@map("branches")
}

/// Persona con credenciales de acceso (no lleva rol propio: el rol es por empresa).
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  companyUsers       CompanyUser[]
  refreshTokens      RefreshToken[]
  auditLogs          AuditLog[]
  invitationsSent    Invitation[]   @relation("InvitationsSent")
  invitationsRevoked Invitation[]   @relation("InvitationsRevoked")

  @@map("users")
}

/// Rol asignable por empresa (Superadministrador, Administrador Estrategos,
/// Consultor, Propietario, Administrador de empresa, Contador externo,
/// Empleado, Auditor — sección 6.3 del documento fuente).
model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  companyUsers CompanyUser[]
  invitations  Invitation[]

  @@map("roles")
}

/// Tabla puente: un usuario tiene un rol DISTINTO por cada empresa a la que accede.
model CompanyUser {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  companyId String   @map("company_id")
  roleId    String   @map("role_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])
  role    Role    @relation(fields: [roleId], references: [id])

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([companyId, isActive])
  @@map("company_users")
}

/// Invitación de un usuario a una empresa con un rol (M01, RN-USR-*).
/// El token en sí nunca se persiste, solo su hash (tokenHash).
/// El estado (pendiente/aceptada/revocada/expirada) se calcula a partir de
/// acceptedAt/revokedAt/expiresAt — no hay columna de estado redundante.
model Invitation {
  id              String    @id @default(uuid())
  companyId       String    @map("company_id")
  email           String
  roleId          String    @map("role_id")
  tokenHash       String    @map("token_hash")
  invitedByUserId String    @map("invited_by_user_id")
  revokedByUserId String?   @map("revoked_by_user_id")
  expiresAt       DateTime  @map("expires_at")
  acceptedAt      DateTime? @map("accepted_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  company   Company @relation(fields: [companyId], references: [id])
  role      Role    @relation(fields: [roleId], references: [id])
  invitedBy User    @relation("InvitationsSent", fields: [invitedByUserId], references: [id])
  revokedBy User?   @relation("InvitationsRevoked", fields: [revokedByUserId], references: [id])

  @@index([companyId])
  @@index([email])
  @@map("invitations")
}

/// Refresh tokens rotables y revocables (nunca se guarda el token en texto plano).
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

/// Registro inmutable de acciones sensibles (RN-009). No editable por diseño:
/// no se expone ningún endpoint PATCH/DELETE para este modelo.
model AuditLog {
  id         String   @id @default(uuid())
  companyId  String?  @map("company_id")
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  company Company? @relation(fields: [companyId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([entityType, entityId])
  // Soporta reportes de auditoría filtrados por empresa y período (R09) sin
  // table scan a medida que la tabla crece sin límite (ver decisión en
  // docs/ARQUITECTURA.md sección 8).
  @@index([companyId, createdAt])
  @@map("audit_logs")
}

/// Tercero: persona física o jurídica con la que la empresa opera (M03/M04).
/// Datos fiscales/legales/de contacto compartidos entre Cliente y Proveedor
/// para que la misma persona pueda ser ambos sin duplicar información
/// (decisión de Sprint 2, ver docs/sprint-2/01-clientes-proveedores.md §0.4).
model Party {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  legalName    String   @map("legal_name")
  taxId        String?  @map("tax_id")
  taxCondition String?  @map("tax_condition")
  email        String?
  phone        String?
  address      String?
  contactName  String?  @map("contact_name")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company  Company   @relation(fields: [companyId], references: [id])
  customer Customer?
  supplier Supplier?

  @@unique([companyId, taxId])
  @@index([companyId])
  @@map("parties")
}

/// Rol de Cliente de un Party (M03). `companyId` duplicado deliberadamente
/// respecto de Party.companyId — ver decisión de escalabilidad en
/// docs/sprint-2/01-clientes-proveedores.md §0.5: nunca se edita
/// independientemente, mantiene el patrón de columna directa de todo el
/// sistema y deja el terreno listo para Row Level Security.
model Customer {
  id                   String   @id @default(uuid())
  partyId              String   @unique @map("party_id")
  companyId            String   @map("company_id")
  paymentTermDays      Int?     @map("payment_term_days")
  creditLimit          Decimal? @map("credit_limit") @db.Decimal(14, 2)
  preferredPriceListId String?  @map("preferred_price_list_id")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  party              Party      @relation(fields: [partyId], references: [id])
  company            Company    @relation(fields: [companyId], references: [id])
  preferredPriceList PriceList? @relation(fields: [preferredPriceListId], references: [id])

  @@index([companyId])
  @@index([companyId, isActive])
  @@map("customers")
}

/// Rol de Proveedor de un Party (M04). Mismas notas que Customer sobre
/// companyId duplicado. paymentTermDays tiene significado inverso al de
/// Customer (condición de compra, no de venta) — por eso no se comparte
/// aunque el tipo sea igual.
model Supplier {
  id                String   @id @default(uuid())
  partyId           String   @unique @map("party_id")
  companyId         String   @map("company_id")
  paymentTermDays   Int?     @map("payment_term_days")
  bankName          String?  @map("bank_name")
  bankAccountHolder String?  @map("bank_account_holder")
  bankCbu           String?  @map("bank_cbu")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  party   Party   @relation(fields: [partyId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([companyId, isActive])
  @@map("suppliers")
}

/// Categoría jerárquica de Ítems (Sprint 3, docs/sprint-3/01-catalogo-maestro.md).
/// Lista de adyacencia (parentId autoreferenciado), profundidad ilimitada.
model Category {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  parentId  String?  @map("parent_id")
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company  Company    @relation(fields: [companyId], references: [id])
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  items    Item[]

  @@index([companyId])
  @@index([companyId, parentId])
  @@map("categories")
}

enum ItemType {
  PRODUCT
  SERVICE
}

/// Producto o Servicio unificado (RN-CAT-06/07/08). tracksStock/minimumStock
/// solo tienen sentido si type = PRODUCT.
model Item {
  id            String   @id @default(uuid())
  companyId     String   @map("company_id")
  type          ItemType
  sku           String
  name          String
  description   String?
  categoryId    String?  @map("category_id")
  unitOfMeasure String   @map("unit_of_measure")
  tracksStock   Boolean  @default(false) @map("tracks_stock")
  minimumStock  Decimal? @map("minimum_stock") @db.Decimal(14, 2)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  company        Company         @relation(fields: [companyId], references: [id])
  category       Category?       @relation(fields: [categoryId], references: [id])
  itemTaxes      ItemTax[]
  priceListItems PriceListItem[]

  @@unique([companyId, sku])
  @@index([companyId])
  @@index([companyId, isActive])
  @@index([companyId, type])
  @@map("items")
}

enum TaxType {
  VAT
  PERCEPTION
  WITHHOLDING
}

/// Catálogo flexible de impuestos con vigencia (RN-CAT-09/10). La tasa nunca
/// se edita retroactivamente: "cambiar" una tasa es cerrar este Tax
/// (validTo) y crear uno nuevo — preserva la integridad de comprobantes
/// históricos que en Sprint 3.3 copiarán (snapshot) la tasa vigente.
model Tax {
  id        String    @id @default(uuid())
  companyId String    @map("company_id")
  name      String
  type      TaxType
  rate      Decimal   @db.Decimal(6, 4)
  validFrom DateTime  @map("valid_from")
  validTo   DateTime? @map("valid_to")
  createdAt DateTime  @default(now()) @map("created_at")

  company   Company   @relation(fields: [companyId], references: [id])
  itemTaxes ItemTax[]

  @@index([companyId])
  @@map("taxes")
}

/// Qué impuestos aplican a qué Ítem (RN-CAT-11: un Item puede tener más de
/// uno simultáneamente, ej. IVA + Percepción IIBB).
model ItemTax {
  itemId String @map("item_id")
  taxId  String @map("tax_id")

  item Item @relation(fields: [itemId], references: [id])
  tax  Tax  @relation(fields: [taxId], references: [id])

  @@id([itemId, taxId])
  @@map("item_taxes")
}

/// Lista de precios (neto, sin impuestos — ver §5.2 del documento de
/// arquitectura). RN-CAT-13: a lo sumo una activa por empresa con
/// isDefault = true.
model PriceList {
  id        String    @id @default(uuid())
  companyId String    @map("company_id")
  name      String
  currency  String
  isDefault Boolean   @default(false) @map("is_default")
  validFrom DateTime  @default(now()) @map("valid_from")
  validTo   DateTime? @map("valid_to")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  company              Company         @relation(fields: [companyId], references: [id])
  items                PriceListItem[]
  preferredByCustomers Customer[]

  @@index([companyId])
  @@index([companyId, isActive])
  @@map("price_lists")
}

/// Precio de un Ítem en una Lista de precios. A diferencia del resto del
/// módulo, admite baja física (RN-CAT-04): no es un registro financiero, el
/// precio históricamente facturado queda protegido aparte, como snapshot en
/// la línea del comprobante (Sprint 3.3).
model PriceListItem {
  priceListId String   @map("price_list_id")
  itemId      String   @map("item_id")
  price       Decimal  @db.Decimal(14, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  priceList PriceList @relation(fields: [priceListId], references: [id])
  item      Item      @relation(fields: [itemId], references: [id])

  @@id([priceListId, itemId])
  @@map("price_list_items")
}
