# Copiar a .env.production y completar con valores REALES.
# NUNCA commitear .env.production — ya está en .gitignore junto con .env.
#
# Si usás docker-compose.yml tal cual viene, DATABASE_URL se pisa con el
# valor que apunta al servicio "postgres" del propio compose — no hace
# falta completarlo acá salvo que despliegues la API contra un Postgres
# externo (managed DB de tu hosting, por ejemplo).
DATABASE_URL="postgresql://usuario:password@host:5432/estrategos"

# Generar cada uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Deben ser DISTINTOS entre sí y de cualquier valor usado en dev/test.
# Rotar significa invalidar TODAS las sesiones activas (todos los JWT
# firmados con el secreto viejo dejan de validar).
JWT_SECRET="reemplazar-con-un-secreto-largo-y-aleatorio-de-produccion"
JWT_REFRESH_SECRET="reemplazar-con-otro-secreto-distinto-de-produccion"

PORT=3001

# Dominio real del frontend, SIN barra final. Múltiples orígenes separados
# por coma. Si se omite, el API rechaza todo acceso cross-origin del
# navegador por defecto (ver hallazgo Medio #5 de la auditoría de
# seguridad — fail-closed, no fail-open).
CORS_ORIGIN="https://tu-dominio.com"

NODE_ENV=production
