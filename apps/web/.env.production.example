# Copiar a .env.production y completar con valores REALES.
# NUNCA commitear .env.production.
#
# IMPORTANTE: esta variable se incrusta en el bundle en tiempo de BUILD
# (convención NEXT_PUBLIC_* de Next.js), no de arranque del contenedor.
# Si usás el Dockerfile/docker-compose de este repo, pasala como
# --build-arg NEXT_PUBLIC_API_URL=... (ver docker-compose.yml) — el valor
# que pongas acá en .env.production NO tiene efecto en esa imagen ya
# construida, solo sirve como documentación/referencia o para un
# `next build` corrido directamente fuera de Docker.
NEXT_PUBLIC_API_URL="https://api.tu-dominio.com"

NODE_ENV=production
